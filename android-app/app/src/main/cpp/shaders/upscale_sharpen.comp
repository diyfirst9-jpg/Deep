#version 450

// CAS-lite single-pass upscale + sharpen.
//
// Reads the framegen output (src, lower res, sampled bilinear) and writes
// directly into the swapchain image (dst, native res) in one dispatch —
// this REPLACES vkCmdBlitImage in blitOutputToSwapchain's scaled path when
// the toggle is on, it does not run in addition to it. Same command buffer,
// same submit, no extra vkQueueSubmit/semaphore round trip (see
// blitOutputToSwapchain fuse point).
//
// Algorithm: bilinear upscale for the base sample, then a cheap
// contrast-adaptive sharpen using the 4 orthogonal taps at the output
// pixel's footprint in source space (not a full 3x3 min/max CAS - kept to
// 5 taps total to stay cheap on Mali).

layout(local_size_x = 8, local_size_y = 8) in;

layout(binding = 0) uniform sampler2D srcImage;
layout(binding = 1, rgba8) uniform writeonly image2D dstImage;

layout(push_constant) uniform PushConstants {
    vec2 srcTexelSize;   // 1.0 / srcExtent
    vec2 dstExtent;      // output width/height in pixels
    float sharpenAmount; // 0..1, matches Deepdrop's existing CAS post-process range
} pc;

void main() {
    ivec2 dstCoord = ivec2(gl_GlobalInvocationID.xy);
    if (dstCoord.x >= int(pc.dstExtent.x) || dstCoord.y >= int(pc.dstExtent.y)) return;

    vec2 uv = (vec2(dstCoord) + 0.5) / pc.dstExtent;

    vec3 center = texture(srcImage, uv).rgb;
    vec3 up     = textureOffset(srcImage, uv, ivec2(0, -1)).rgb;
    vec3 down   = textureOffset(srcImage, uv, ivec2(0,  1)).rgb;
    vec3 left   = textureOffset(srcImage, uv, ivec2(-1, 0)).rgb;
    vec3 right  = textureOffset(srcImage, uv, ivec2(1,  0)).rgb;

    // CAS-style local contrast: how far the center deviates from the
    // neighborhood min/max drives how hard we sharpen, so flat regions
    // (sky, UI panels) stay clean and edges get the correction.
    vec3 minC = min(center, min(min(up, down), min(left, right)));
    vec3 maxC = max(center, max(max(up, down), max(left, right)));
    vec3 range = max(maxC - minC, vec3(1e-4));

    vec3 blurred = (up + down + left + right) * 0.25;
    vec3 detail = center - blurred;

    // Clamp sharpen strength by local contrast so it never rings past the
    // neighborhood's own min/max.
    float strength = pc.sharpenAmount * clamp(1.0 - length(range), 0.0, 1.0) + pc.sharpenAmount * 0.5;
    vec3 sharpened = center + detail * strength;

    imageStore(dstImage, dstCoord, vec4(clamp(sharpened, 0.0, 1.0), 1.0));
}
